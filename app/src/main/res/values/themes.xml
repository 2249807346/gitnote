<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.GitNote" parent="android:Theme.Material.NoActionBar">
        <!-- 启用状态栏透明，让内容可以延伸到状态栏 -->
        <item name="android:windowTranslucentStatus">true</item>
        <!-- 强制状态栏对比度，确保图标可见性 -->
        <item name="android:enforceStatusBarContrast">true</item>
    </style>
</resources>